+#        new bindings)
 #
-# Serve notes (2-node TP2): --moe-backend marlin --linear-backend triton,
-# VLLM_DEEP_GEMM_WARMUP=skip (the linear warmup pass feeds raw e8m0 scales to fp8_gemm_nt),
